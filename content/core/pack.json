  "quests": [
    {
      "id": "m1:awakening",
      "name": "星海甦醒",
      "description": "序章：建立第一條航線。",
      "status": "active",
      "provenance": "m1-design",
      "condition": "intro",
      "target": "",
      "count": 1,
      "reward": {},
      "character": "",
      "dialogue": [
        {
          "speaker": "地球",
          "text": "指揮官，聽得見嗎？我們已經抵達曙光星域。遠方那道藍色訊號，也許是一座尚未熄滅的前哨。"
        },
        {
          "speaker": "水星",
          "text": "讓我帶路吧。點擊星海，或用 W A S D 航行。靠近星球後，掃描器會標出它的位置。也可以隨時切換大星圖規劃航線。"
        },
        {
          "speaker": "金星",
          "text": "小心，航路上還有巡邏敵艦。普通攻擊交給我們，指揮官負責走位與技能；想看技能說明，就打開「技能情報」。"
        },
        {
          "speaker": "地球",
          "text": "先尋找蔚藍前哨，再解放並啟動它。穩定的產能會讓我們走得更遠。準備好了，就一起出發吧。"
        }
      ],
      "background": "m1art:bridge-v1"
    },
    {
      "id": "m1:first-light",
      "name": "第一道星光",
      "description": "",
      "status": "active",
